# GitHub Pages Tunnel Configuration
# 
# Required for GitHub Pages to automatically update with your tunnel URL.
# 
# To generate a GitHub token:
# 1. Go to https://github.com/settings/tokens/new
# 2. Select "Generate new token (classic)"
# 3. Scopes needed: repo (full control of private repositories)
# 4. Copy the token and paste below
#
# SECURITY: Put the real token in .env. Never commit your token to git.

GITHUB_TOKEN=ghp_your_token_here

# Optional: Override GitHub owner/repo detection (usually auto-detected from git remote)
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=book-of-life
# GITHUB_BRANCH=main

# Optional: Server port (default 3000)
# PORT=3000
