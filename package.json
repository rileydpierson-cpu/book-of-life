{
  "name": "book-of-life",
  "version": "1.0.0",
  "description": "Local-first journal and photo timeline viewer",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm run build && node scripts/start-with-tunnel.js",
    "start:local": "npm run build && node server.js",
    "dev": "node --watch server.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "heic-convert": "^2.1.0",
    "markdown-it": "^14.1.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "localtunnel": "^2.0.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
