{
  "server": {
    "port": 3000
  },
  "auth": {
    "enabled": true,
    "allowedUsers": "${LIFESERVER_ALLOWED_USERS}",
    "userStorePath": "./storage/auth/users.json",
    "sessionDays": 30,
    "secureCookie": false
  },
  "paths": {
    "journalVault": "${LIFESERVER_JOURNAL_VAULT}",
    "journalFolderName": "Journal",
    "journalImagesFolderName": "Images",
    "photoFolders": [
      "${LIFESERVER_PHOTO_ROOT}"
    ],
    "deviceSyncRoot": "./storage/device-sync",
    "includeDeviceSyncRoot": true,
    "cacheDir": "${LIFESERVER_CACHE_DIR}"
  },
  "indexing": {
    "rebuildIntervalMs": 300000,
    "chunkSize": 24
  }
}
